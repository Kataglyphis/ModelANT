  "decode": {
    "layout": "xyxy_score_class",
    "rules": [
      "1. A row is a detection only when its score is finite and at least score_threshold.",
      "2. Its class must be a number with output.class_range[0] <= class < output.class_range[1] + 1; the class id is that number cut toward zero.",
      "3. Its four corners must be finite, with x2 >= x1 and y2 >= y1; a point stays.",
      "4. No overlap suppression: every row that passes rules 1 to 3 is a detection, whatever it overlaps.",
      "5. Each corner maps to the frame as (x - pad_x) / scale_x and (y - pad_y) / scale_y; then x is cut to [0, width] and y to [0, height]."
    ],
    "non_finite": ["NaN", "Infinity", "-Infinity"],
    "order": "row",
    "score_tolerance": 0.000001,
    "coordinate_tolerance": 0.01,
