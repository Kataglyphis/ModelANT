  },
  "raw_decode": {
    "layouts": {
      "cxcywh_objectness_scores": "[1, candidates, 5 + classes]: rows of cx, cy, w, h, objectness, then one score per class; output holds the rows.",
      "cxcywh_scores_by_anchor": "[1, 4 + classes, anchors]: columns of cx, cy, w, h, then one score per class; output holds the matrix as the model writes it, one row per value."
    },
    "rules": [
      "1. A candidate's score is its objectness times its best class score (cxcywh_objectness_scores), or its best class score (cxcywh_scores_by_anchor), the best over every class column; its class is the first column holding that score.",
      "2. A candidate is kept only when its score is at least score_threshold.",
      "3. Its corners are cx - w/2, cy - h/2, cx + w/2 and cy + h/2, in model-input pixels.",
      "4. The kept candidates are taken in descending score, ties to the lower candidate; each suppresses every later candidate of its class whose IoU with it, in model-input pixels before any mapping or cut, is above iou_threshold. The survivors come in that order.",
      "5. Each survivor maps to the frame as decode rule 5 says: (x - pad_x) / scale_x and (y - pad_y) / scale_y, then x is cut to [0, width] and y to [0, height]."
    ],
    "iou_threshold": 0.45,
    "order": "score",
    "score_tolerance": 1e-06,
    "coordinate_tolerance": 0.01,
    "cases": [
      {
        "name": "objectness_times_the_best_class",
        "rule": 1, "layout": "cxcywh_objectness_scores",
        "width": 640, "height": 640, "input_width": 640, "input_height": 640, "mode": "stretch",
        "mapping": {"content_width": 640, "content_height": 640, "pad_x": 0, "pad_y": 0, "scale_x": 1.0, "scale_y": 1.0},
        "score_threshold": 0.25,
        "output": [
          [100, 100, 40, 40, 0.5, 0.25, 0.75, 0.125],
          [300, 300, 40, 40, 0.75, 0.625, 0.25, 0.125],
          [500, 100, 40, 40, 1, 0.5, 0.5, 0.25],
          [500, 500, 40, 40, 0.25, 0.75, 0.5, 0.5]
        ],
        "expected": [
          {"candidate": 2, "class": 0, "score": 0.5, "box": [480, 80, 520, 120]},
          {"candidate": 1, "class": 0, "score": 0.46875, "box": [280, 280, 320, 320]},
          {"candidate": 0, "class": 1, "score": 0.375, "box": [80, 80, 120, 120]}
        ]
      },
      {
        "name": "same_class_overlap_above_0_45_keeps_the_stronger",
        "rule": 4, "layout": "cxcywh_objectness_scores",
        "width": 640, "height": 640, "input_width": 640, "input_height": 640, "mode": "stretch",
        "mapping": {"content_width": 640, "content_height": 640, "pad_x": 0, "pad_y": 0, "scale_x": 1.0, "scale_y": 1.0},
        "score_threshold": 0.25,
        "output": [
          [100, 100, 100, 100, 1, 0.75, 0],
          [136, 100, 100, 100, 1, 0.875, 0],
          [400, 400, 100, 100, 1, 0.5, 0]
        ],
        "expected": [
          {"candidate": 1, "class": 0, "score": 0.875, "box": [86, 50, 186, 150]},
          {"candidate": 2, "class": 0, "score": 0.5, "box": [350, 350, 450, 450]}
        ]
      },
      {
        "name": "same_class_overlap_at_most_0_45_stays",
        "rule": 4, "layout": "cxcywh_objectness_scores",
        "width": 640, "height": 640, "input_width": 640, "input_height": 640, "mode": "stretch",
        "mapping": {"content_width": 640, "content_height": 640, "pad_x": 0, "pad_y": 0, "scale_x": 1.0, "scale_y": 1.0},
        "score_threshold": 0.25,
        "output": [
          [100, 100, 100, 100, 1, 0.875, 0],
          [140, 100, 100, 100, 1, 0.75, 0]
        ],
        "expected": [
          {"candidate": 0, "class": 0, "score": 0.875, "box": [50, 50, 150, 150]},
          {"candidate": 1, "class": 0, "score": 0.75, "box": [90, 50, 190, 150]}
        ]
      },
      {
        "name": "different_classes_never_suppress",
