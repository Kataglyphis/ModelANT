        "rule": 5,
        "width": 720, "height": 1280, "input_width": 640, "input_height": 640, "mode": "letterbox",
        "mapping": {"content_width": 360, "content_height": 640, "pad_x": 140, "pad_y": 0, "scale_x": 0.5, "scale_y": 0.5},
        "score_threshold": 0.5,
        "rows": [
          [240, 100, 440, 300, 0.9, 15],
          [140, 0, 500, 640, 0.8, 0]
        ],
        "expected": [
          {"row": 0, "class": 15, "score": 0.9, "box": [200, 200, 600, 600]},
          {"row": 1, "class": 0, "score": 0.8, "box": [0, 0, 720, 1280]}
        ]
      },
      {
        "name": "letterbox_box_in_padding_cut",
        "rule": 5,
        "width": 1280, "height": 720, "input_width": 640, "input_height": 640, "mode": "letterbox",
        "mapping": {"content_width": 640, "content_height": 360, "pad_x": 0, "pad_y": 140, "scale_x": 0.5, "scale_y": 0.5},
        "score_threshold": 0.5,
        "rows": [
          [0, 100, 640, 320, 0.9, 15],
          [320, 400, 480, 560, 0.8, 15],
          [-10, 0, 650, 640, 0.7, 0]
        ],
        "expected": [
          {"row": 0, "class": 15, "score": 0.9, "box": [0, 0, 1280, 360]},
          {"row": 1, "class": 15, "score": 0.8, "box": [640, 520, 960, 720]},
          {"row": 2, "class": 0, "score": 0.7, "box": [0, 0, 1280, 720]}
        ]
      }
    ]
