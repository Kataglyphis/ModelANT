    "find": "    if license_id not in COMMUNITY:",
    "replace": "    if False:",
    "test": "python3 -I scripts/tests/test_license_policy.py",
    "why": "A license outside the policy must be refused by name, not judged as a community license."
  },
  {
    "id": "license.obligations-required",
    "target": "scripts/license_policy.py",
    "find": "    if not obligations:",
    "replace": "    if False:",
    "test": "python3 -I scripts/tests/test_license_policy.py",
    "why": "A Llama or Gemma model without recorded obligations would ship without the notices its license demands."
  },
  {
